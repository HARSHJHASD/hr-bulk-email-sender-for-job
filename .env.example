# Copy this file to `mailer/.env` and fill it in. `.env` is gitignored.

# --- Gmail SMTP ---------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=harshjha19101997@gmail.com

# 16-character Gmail App Password (NOT your normal Google password).
# https://myaccount.google.com/apppasswords  — needs 2-Step Verification enabled.
# Spaces are fine, they get stripped automatically.
SMTP_PASS=

# --- Identity ----------------------------------------------------------------
FROM_NAME=fromName
REPLY_TO=youremail(personal)

# --- Safety ------------------------------------------------------------------
# Delay between sends, in ms (±30% jitter is applied). 2000 = one mail per ~5s.
THROTTLE_MS=2000

# Gmail's rolling 24h send limit for free accounts is ~500.
DAILY_CAP=500

# Dashboard port
PORT=8787
